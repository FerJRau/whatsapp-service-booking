# WhatsApp Business API Configuration
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_API_VERSION=v18.0

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_booking
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Security Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
WEBHOOK_SECRET=your_webhook_secret_for_signature_verification

# Redis Configuration (for session management)
REDIS_URL=redis://localhost:6379/0

# Application Configuration
APP_NAME=WhatsApp Service Booking
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Session Management
SESSION_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=1000

# Supplier Management
SUPPLIER_RESPONSE_TIMEOUT_SECONDS=300
MAX_SUPPLIERS_PER_REQUEST=5

# Performance Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Business Rules
DEFAULT_SERVICE_AREA_RADIUS_KM=50
EMERGENCY_RESPONSE_TIME_MINUTES=15
STANDARD_RESPONSE_TIME_MINUTES=60
